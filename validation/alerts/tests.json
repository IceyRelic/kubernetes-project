          "exp_alerts": [
            {
              "exp_labels": {
                "namespace": "logging",
                "deployment": "kibana",
                "severity": "critical",
                "project": "k8s-efk-lab"
              },
              "exp_annotations": {
                "summary": "Kibana没有可用副本",
                "description": "检查logging/kibana状态及Elasticsearch连接；replicas=0的计划停用不触发此规则。"
              }
            }
          ]
        },
        {
          "eval_time": "27m",
          "alertname": "LabKibanaNoAvailableReplica",
          "exp_alerts": []
        }
      ]
