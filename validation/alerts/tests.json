        {
          "series": "kube_deployment_spec_replicas{namespace=\"logging\",deployment=\"kibana\"}",
          "values": "1+0x28"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "1m",
          "alertname": "LabKibanaNoAvailableReplica",
