          "exp_alerts": [
            {
              "exp_labels": {
                "namespace": "logging",
                "pod": "test",
                "container": "test",
                "severity": "warning",
                "project": "k8s-efk-lab"
              },
              "exp_annotations": {
                "summary": "应用或日志容器接近内存上限",
                "description": "连续10分钟工作集超过limit的90%；工作集不是JVM堆，需结合进程和宿主内存检查。"
              }
            }
          ]
        },
        {
          "eval_time": "27m",
          "alertname": "LabApplicationNearMemoryLimit",
          "exp_alerts": []
        }
      ]
