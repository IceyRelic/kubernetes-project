    {
      "name": "LabApplicationNewOOM 正常/等待/触发/恢复",
      "interval": "1m",
      "input_series": [
        {
          "series": "kube_pod_container_status_last_terminated_reason{namespace=\"logging\",pod=\"test\",container=\"test\",reason=\"OOMKilled\"}",
          "values": "0 0 1+0x17 0+0x8"
        },
        {
          "series": "kube_pod_container_status_restarts_total{namespace=\"logging\",pod=\"test\",container=\"test\"}",
          "values": "0 0 1+1x17 18+0x8"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "1m",
          "alertname": "LabApplicationNewOOM",
          "exp_alerts": []
        },
        {
          "eval_time": "2m",
          "alertname": "LabApplicationNewOOM",
          "exp_alerts": []
        },
        {
          "eval_time": "9m",
          "alertname": "LabApplicationNewOOM",
          "exp_alerts": [
            {
              "exp_labels": {
                "namespace": "logging",
                "pod": "test",
                "container": "test",
                "severity": "critical",
                "project": "k8s-efk-lab"
              },
              "exp_annotations": {
                "summary": "应用或日志容器发生新的OOM重启",
                "description": "结合最近重启增量判断，避免旧OOM原因一直报警；检查宿主压力及容器limit。"
              }
            }
          ]
        },
        {
          "eval_time": "27m",
          "alertname": "LabApplicationNewOOM",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "LabApplicationNearMemoryLimit 正常/等待/触发/恢复",
      "interval": "1m",
      "input_series": [
        {
          "series": "container_memory_working_set_bytes{namespace=\"logging\",pod=\"test\",container=\"test\"}",
          "values": "50 50 95+0x17 50+0x8"
        },
        {
          "series": "kube_pod_container_resource_limits{namespace=\"logging\",pod=\"test\",container=\"test\",resource=\"memory\"}",
          "values": "100+0x28"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "1m",
          "alertname": "LabApplicationNearMemoryLimit",
          "exp_alerts": []
        },
        {
          "eval_time": "2m",
          "alertname": "LabApplicationNearMemoryLimit",
