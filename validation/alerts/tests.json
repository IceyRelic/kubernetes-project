          "series": "kube_daemonset_status_number_ready{namespace=\"logging\",daemonset=\"fluent-bit\"}",
          "values": "5 5 4+0x17 5+0x8"
        },
        {
          "series": "kube_daemonset_status_desired_number_scheduled{namespace=\"logging\",daemonset=\"fluent-bit\"}",
          "values": "5+0x28"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "1m",
          "alertname": "LabFluentBitCoverageIncomplete",
          "exp_alerts": []
        },
        {
          "eval_time": "2m",
          "alertname": "LabFluentBitCoverageIncomplete",
          "exp_alerts": []
        },
        {
          "eval_time": "13m",
          "alertname": "LabFluentBitCoverageIncomplete",
          "exp_alerts": [
            {
              "exp_labels": {
                "namespace": "logging",
                "daemonset": "fluent-bit",
                "severity": "warning",
                "project": "k8s-efk-lab"
              },
              "exp_annotations": {
                "summary": "Fluent Bit采集覆盖不足",
                "description": "检查未就绪节点的采集Pod；此规则比较当前期望与就绪数，不固定写死5台。"
              }
            }
          ]
        },
        {
          "eval_time": "27m",
          "alertname": "LabFluentBitCoverageIncomplete",
          "exp_alerts": []
        }
      ]
    },
