{
  "rule_files": [
    "rules.json"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "name": "LabESNoReadyReplica 正常/等待/触发/恢复",
      "interval": "1m",
      "input_series": [
        {
          "series": "kube_statefulset_status_replicas_ready{namespace=\"logging\",statefulset=\"elasticsearch\"}",
          "values": "1 1 0+0x17 1+0x8"
        },
        {
          "series": "kube_statefulset_replicas{namespace=\"logging\",statefulset=\"elasticsearch\"}",
          "values": "1+0x28"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "1m",
          "alertname": "LabESNoReadyReplica",
          "exp_alerts": []
        },
        {
          "eval_time": "2m",
          "alertname": "LabESNoReadyReplica",
          "exp_alerts": []
        },
        {
          "eval_time": "10m",
          "alertname": "LabESNoReadyReplica",
          "exp_alerts": [
            {
              "exp_labels": {
                "namespace": "logging",
                "statefulset": "elasticsearch",
                "severity": "critical",
                "project": "k8s-efk-lab"
              },
              "exp_annotations": {
                "summary": "Elasticsearch没有就绪副本",
                "description": "检查logging/elasticsearch Pod、PVC及NFS；单副本实验没有高可用保证。"
              }
            }
          ]
        },
        {
          "eval_time": "27m",
          "alertname": "LabESNoReadyReplica",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "LabKibanaNoAvailableReplica 正常/等待/触发/恢复",
